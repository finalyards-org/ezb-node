#!/usr/bin/env just --justfile

default:
    @just --list

# For 'esp-idf-sys' builds, 'nightly' is a must. 'rust-toolchain.toml' adds it to us, and may enforce a specific version.
# This is only for commentary purposes.
nightly := ""

alias b:= build
alias bc:= build-coordinator
alias br:= build-router

build: build-coordinator

build-all: build-coordinator build-router

build-coordinator:
	cargo {{nightly}} build --release -vv \
		--jobs 1 \
		--features coordinator,_dt_all

# Handling remotes is specific to the router.
build-router:
	cargo {{nightly}} build --release -vv \
		--jobs 1 \
		--features router,_dt_all,_remote_all

# It is possible to also make a coordinator without any endpoint profiles.
build-coordinator-bare:
	cargo {{nightly}} build --release -vv \
		--features coordinator
