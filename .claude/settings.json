{
  "permissions": {
    "allow": [
      "Bash(cargo check*)",
      "Bash(cargo build*)",
      "Bash(cargo clippy*)",
      "Bash(cargo test*)",
      "Bash(cargo doc*)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "deny": [
      "Bash(rm -rf*)",
      "Bash(git push*)",
      "Bash(espflash*)",
      "Read(./.env*)",
      "Read(**/*secret*)"
    ]
  }
}
