# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true

[*.rs]
indent_size = 4

[*.toml]
indent_size = 4

# Using 'Justfile' is optional, but let's make the indentations proper.
[Justfile]
indent_style = tab
indent_size = 4
