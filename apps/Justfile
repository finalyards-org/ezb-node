#!/usr/bin/env just --justfile

#
# Development helper targets. Optional.
#
# Usage:
#   <<
#     $ just {--list|{..target..}}
#   <<
#
default:
    @just --list

# NOTE:
#	For 'esp-idf-sys' builds, 'nightly' is a must. 'rust-toolchain.toml' adds it to us, and may enforce a specific version.
nightly := ""

[group('light')]
lb: light-build
light-build:
	cargo {{nightly}} build --release -vv --bin light \
		--jobs 1

[group('light')]
lr: light-run
light-run:
	cargo {{nightly}} run --release -vv --bin light
