#!/usr/bin/env just --justfile

#
# Development helper targets. Optional.
#
# Requires:
#	- jq
#
default:
    @just --list

alias lb := light-build
alias lr := light-run
alias sb := switch-build
alias sr := switch-run
alias db := door-build
alias dr := door-run

# For 'esp-idf-sys' builds, 'nightly' is a must. 'rust-toolchain.toml' adds it to us, and may enforce a specific version.
# This is only for commentary purposes.
nightly := ""

target_dir := `cargo metadata --format-version 1 --no-deps | jq -r '.target_directory'`

export RUST_LOG := "debug"

# 1-light
[group('light')]
light-build:
	cargo {{nightly}} build --release -vv --bin 1-light --features esp32c6,ezb-node/coordinator,ezb-node/dt_color_dimmable_light \
		--jobs 1

[group('light')]
light-run:
	cargo {{nightly}} run --release -vv --bin 1-light --features esp32c6,ezb-node/coordinator,ezb-node/dt_color_dimmable_light

# 1-switch
[group('switch')]
switch-build:
	cargo {{nightly}} build --release -vv --bin 1-switch --features esp32c6,futures-util,ezb-node/router,ezb-node/dt_color_dimmer_switch,ezb-node/remote_dt_color_dimmable_light \
		--jobs 1

[group('switch')]
switch-run:
	cargo {{nightly}} run --release -vv --bin 1-switch --features esp32c6,futures-util,ezb-node/router,ezb-node/dt_color_dimmer_switch,ezb-node/remote_dt_color_dimmable_light

# 2-door
[group('door')]
door-build:
	RUST_BACKTRACE=1 \
	cargo {{nightly}} build --release -vv --bin 2-door --features esp32c6,ezb-node/coordinator,ezb-node/dt_ias_cie,ezb-node/remote_cl_power_config \
		--jobs 1

[group('door')]
door-run:
	cargo {{nightly}} run --release -vv --bin 2-door --features esp32c6,ezb-node/coordinator,ezb-node/dt_ias_cie,ezb-node/remote_cl_power_config

# Remove generated files
_clean:
    rm -i demo/**/.conf.rs

#--- EXPERIMENTAL
#

# Path to the *last* 'sdkconfig' of THIS project (the target dir may be shared with other projects)
sdkconfig-path:
	@echo "$(tools/check-sdkconfig.sh --out-dir sdkconfig.defaults {{target_dir}})/sdkconfig"

# Path to the *last* 'project_description.json' of THIS project
project_description-path:
	@echo "$(tools/check-sdkconfig.sh --out-dir sdkconfig.defaults {{target_dir}})/build/project_description.json"

# Check 'sdkconfig.defaults' keys against the ESP-IDF used by the last build (name validity + applied values)
sdkconfig-check:
	tools/check-sdkconfig.sh sdkconfig.defaults {{target_dir}}
