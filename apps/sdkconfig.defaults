#
# sdkconfig.defaults
#
# For an application that uses:
#   - esp-zigbee-lib
#
# WARN! If you misspell a config (or use one you only dream existed), ESP-IDF build chain will **warn**, but not stop
#     the build! Keep an eye on the build output!!
#
#     // Understandable in the way that the configs are intended to be worked on using 'menuconfig', not manual edits.

# Rust needs more main task stack size compared to C
#   - C 'esp_zigbee_sdk' examples use 4096
CONFIG_ESP_MAIN_TASK_STACK_SIZE=20000

# Recommended by 'esp-idf-svc', at least if (as we do) 'embassy-time-driver' is being used.
CONFIG_ESP_TIMER_TASK_STACK_SIZE=4096
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=8192
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192

# 1 ms granularity for (FreeRTOS) thread sleeps (10 ms by default).
# This is likely vital, for having 'esp-zigbee-lib' respond in a timely manner.
CONFIG_FREERTOS_HZ=1000

#---
# Zigbee
#|CONFIG_ZB_ENABLED=y
#|CONFIG_ZB_ZCZR=y
#|    # Controller/Router code included (can also do EndDevices with this)
#|CONFIG_ZB_RADIO_NATIVE=y

#??? should it be kept here?
# Partition Table
# based on 'esp-zigbee-sdk' > examples > home_automation_devices
#
# These ARE NOT properly handled by 'esp-idf-sys' (0.37.2) |1|, leading to a build error on 'apps':
#   <<
#         CMake Warning at /home/ubuntu/.espressif/esp-idf/v5.5.4/components/partition_table/project_include.cmake:37 (message):
#    Partition table CSV file
#    /home/ubuntu/target/riscv32imac-esp-espidf/release/build/esp-idf-sys-15e6d77135ef9b21/out/partitions.csv
#    not found.  Change custom partition CSV path in menuconfig.
#  Call Stack (most recent call first):
#    /home/ubuntu/.espressif/esp-idf/v5.5.4/tools/cmake/build.cmake:469 (include)
#    /home/ubuntu/.espressif/esp-idf/v5.5.4/tools/cmake/build.cmake:720 (__build_process_project_includes)
#    /home/ubuntu/.espressif/esp-idf/v5.5.4/tools/cmake/project.cmake:752 (idf_build_process)
#    CMakeLists.txt:36 (project)
#   <<
#   Let's keep them disabled. That's fine, as long as we flash with the right 'partitions.csv'.
#
#   |1|: "Custom partitions.csv with relative path is not copied to build folder causing build to fail" (GitHub Issues)
#       https://github.com/esp-rs/esp-idf-sys/issues/395
#
#|CONFIG_PARTITION_TABLE_CUSTOM=y
#|CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

#
# mbedTLS
#
# Optimizes the mbedTLS code size by disabling unused features.
# From: 'esp-zigbee-sdk' ||
#   || -> https://github.com/espressif/esp-zigbee-sdk/blob/main/examples/utils/example_common/sdkconfig.mbedtls_minimal

# required
CONFIG_MBEDTLS_AES_C=y
CONFIG_MBEDTLS_CCM_C=y

# unused
CONFIG_MBEDTLS_GCM_C=n
CONFIG_MBEDTLS_CMAC_C=n
CONFIG_MBEDTLS_SHA1_C=n
CONFIG_MBEDTLS_SHA3_C=n
CONFIG_MBEDTLS_SHA512_C=n
CONFIG_MBEDTLS_ECP_DP_SECP384R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP521R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP256K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP256R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP384R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP512R1_ENABLED=n
CONFIG_MBEDTLS_KEY_EXCHANGE_RSA=n
CONFIG_MBEDTLS_KEY_EXCHANGE_RSA_PSK=n
CONFIG_MBEDTLS_KEY_EXCHANGE_ECDHE_RSA=n

## v6.0.3
CONFIG_MBEDTLS_AES_ONLY_128_BIT_KEY_LENGTH=y
CONFIG_MBEDTLS_CTR_DRBG_C=y
CONFIG_MBEDTLS_HMAC_DRBG_C=n
CONFIG_MBEDTLS_X509_RSASSA_PSS_SUPPORT=n
CONFIG_MBEDTLS_CIPHER_MODE_CBC=n
CONFIG_MBEDTLS_CIPHER_MODE_CFB=n
CONFIG_MBEDTLS_CIPHER_MODE_CTR=n
CONFIG_MBEDTLS_CIPHER_MODE_OFB=n
CONFIG_MBEDTLS_CIPHER_MODE_XTS=n
# "PSA_WANT_ALG_RSA_PSS needs CONFIG_MBEDTLS_RSA_C=y on ESP-IDF master" (from 'esp-zigbee-sdk')
CONFIG_MBEDTLS_RSA_C=y
CONFIG_MBEDTLS_MD5_C=n
CONFIG_MBEDTLS_SHA384_C=n

# NOT part of 'esp-zigbee-sdk's (needed for ESP-IDF 6.0.2)
#CONFIG_MBEDTLS_ASYMMETRIC_CRYPTO_SUPPORT=y
#CONFIG_MBEDTLS_SHA256_C=y

# /mbedTLS

# ESP-IDF 6.x has 'Picolibc' by default, leading to '__FILE' compilation problems in 'raw' > 'make manual'.
CONFIG_LIBC_NEWLIB=y
#CONFIG_LIBC_STDOUT_LINE_BUF=y
#CONFIG_LIBC_NEWLIB_NANO_FORMAT=n # is so, by default
CONFIG_ESP_CONSOLE_UART=y

# Avoids a register dump on panic.
#
# Not very pretty this one, either; can likely be worked upon.. (tbd. what's with the DWARF?)
#   <<
#       Backtrace: 0x00000000:0x40814430
#       Backtrace ended abruptly: cannot find DWARF information for instruction at address 0x00000000
#   <<
#CONFIG_ESP_SYSTEM_USE_EH_FRAME=y
# "not recommended to be used for production"

# Another way for registry dump avoidance. NOTE: TRY WITH 'panic' deeper than from main.
#CONFIG_ESP_SYSTEM_USE_FRAME_POINTER=y

# Default is yes; we are not going to use Wifi.
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
