#
# sdkconfig.defaults
#
# For an application that uses:
#   - esp-zigbee-lib
#
# WARN! If you misspell a config (or use one you only dream existed), ESP-IDF build chain will **warn**, but not stop
#     the build! Keep an eye on the build output!!
#
#     // Understandable in the way that the configs are intended to be worked on using 'menuconfig', not manual edits.

# Rust needs more main task stack size compared to C
#   - C 'esp_zigbee_sdk' examples use 4096
CONFIG_ESP_MAIN_TASK_STACK_SIZE=20000

# Recommended by 'esp-idf', at least if (as we do) 'embassy-time-driver' is being used.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=8192
CONFIG_ESP_TIMER_TASK_STACK_SIZE=4096
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192

# 1 ms granularity for (FreeRTOS) thread sleeps (10 ms by default).
# This is likely vital, for having 'esp-zigbee-lib' respond in a timely manner.
CONFIG_FREERTOS_HZ=1000

# Avoids a register dump on panic.
#
# Not very pretty this one; can likely be worked upon..
#
CONFIG_ESP_SYSTEM_USE_EH_FRAME=y
    # "not recommended to be used for production"

# tbd. is this useful?  Would likely provide stack dump information when within ESP-IDF code???
#CONFIG_ESP_SYSTEM_USE_FRAME_POINTER=y

# Avoids a reboot-loop, if the C side were to panic.
CONFIG_ESP_SYSTEM_PANIC_PRINT_HALT=y

# C logging
#
# Default: the logging level we use. Changes to this are made _in code_; can be declared component specific.
# Maximum: keep logs up to this level (including) in the binary. VERBOSE allows adjusting to any log level.
#
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_VERBOSE=y

#---
# From esp-rs/esp-idf/sdkconfig.defaults[.nimble]
#   -> https://github.com/esp-rs/esp-idf/blob/master/sdkconfig.defaults.nimble
#
# "Go figure..."
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096

# "Async SPI only enabled when this config is disabled (it is enabled by default)"
#CONFIG_SPI_MASTER_ISR_IN_IRAM=n

# Suppress deprecation warnings for legacy drivers still included in bindings
CONFIG_I2C_SUPPRESS_DEPRECATE_WARN=y
CONFIG_TWAI_SUPPRESS_DEPRECATE_WARN=y
CONFIG_TOUCH_SUPPRESS_DEPRECATE_WARN=y

CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

#---
# Our own
#CONFIG_BT_ENABLED=n
    # disabled by default

#CONFIG_OPENTHREAD_ENABLED=n
    # disabled by default

# Was on by default (ESP-IDF 6.1)
CONFIG_ESP_WIFI_REMOTE_ENABLED=n

# Is on by default (ESP-IDF 6.1)
# NOTE: THIS DOES NOT STEER IT!! RESEARCH NEEDED.
#   Is it that 'esp-idf-svc' building "std" causes these in, and we cannot counteract that? #help #esp-idf-sys
CONFIG_ESP_WIFI_ENABLED=n

# Switch off coexistence support with Wifi
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=n

#---
# Newlib / picolibc
#
# ESP-IDF 6.x transitioned to 'picolibc' by default, but we likely would get no benefits from it, above 'newlib'.
#
# Without this, we get the error in 'make manual' (raw):
#   <<
#       Unable to generate bindings: clang diagnosed error: /home/lima/.espressif/tools/riscv32-esp-elf/esp-15.2.0_20251204/riscv32-esp-elf/riscv32-esp-elf/include/stdio.h:66:9: error: unknown type name '__FILE'
#       /home/lima/.espressif/tools/riscv32-esp-elf/esp-15.2.0_20251204/riscv32-esp-elf/riscv32-esp-elf/include/stdio.h:696:10: error: member reference base type 'FILE' (aka 'int') is not a structure or union
#       /home/lima/.espressif/tools/riscv32-esp-elf/esp-15.2.0_20251204/riscv32-esp-elf/riscv32-esp-elf/include/stdio.h:696:26: error: member reference base type 'FILE' (aka 'int') is not a structure or union
#       /home/lima/.espressif/tools/riscv32-esp-elf/esp-15.2.0_20251204/riscv32-esp-elf/riscv32-esp-elf/include/stdio.h:696:36: error: member reference base type 'FILE' (aka 'int') is not a structure or union
#       /home/lima/.espressif/tools/riscv32-esp-elf/esp-15.2.0_20251204/riscv32-esp-elf/riscv32-esp-elf/include/stdio.h:697:14: error: member reference base type 'FILE' (aka 'int') is not a structure or union
#       /home/lima/.espressif/tools/riscv32-esp-elf/esp-15.2.0_20251204/riscv32-esp-elf/riscv32-esp-elf/include/stdio.h:750:9: error: use of undeclared identifier '_REENT'
#       /home/lima/.espressif/tools/riscv32-esp-elf/esp-15.2.0_20251204/riscv32-esp-elf/riscv32-esp-elf/include/stdio.h:170:21: error: call to undeclared function '_REENT_STDIN'; ISO C99 and later do not support implicit function declarations [-Wimplicit-function-declaration]
#       /home/lima/.espressif/tools/riscv32-esp-elf/esp-15.2.0_20251204/riscv32-esp-elf/riscv32-esp-elf/include/stdio.h:658:51: error: member reference type 'int' is not a pointer
#       /home/lima/.espressif/tools/riscv32-esp-elf/esp-15.2.0_20251204/riscv32-esp-elf/riscv32-esp-elf/include/stdio.h:170:21: error: incompatible integer to pointer conversion passing 'int' to parameter of type 'FILE *' (aka 'int *') [-Wint-conversion]
#       /home/lima/.espressif/tools/riscv32-esp-elf/esp-15.2.0_20251204/riscv32-esp-elf/riscv32-esp-elf/include/stdio.h:658:98: error: member reference type 'int' is not a pointer
#       /home/lima/.espressif/tools/riscv32-esp-elf/esp-15.2.0_20251204/riscv32-esp-elf/riscv32-esp-elf/include/stdio.h:759:9: error: use of undeclared identifier '_REENT'
#       /home/lima/.espressif/tools/riscv32-esp-elf/esp-15.2.0_20251204/riscv32-esp-elf/riscv32-esp-elf/include/stdio.h:171:22: error: call to undeclared function '_REENT_STDOUT'; ISO C99 and later do not support implicit function declarations [-Wimplicit-function-declaration]
#       /home/lima/.espressif/tools/riscv32-esp-elf/esp-15.2.0_20251204/riscv32-esp-elf/riscv32-esp-elf/include/stdio.h:171:22: error: incompatible integer to pointer conversion passing 'int' to parameter of type 'FILE *' (aka 'int *') [-Wint-conversion]
#   <<
#
CONFIG_LIBC_NEWLIB=y
#CONFIG_NEWLIB_STDOUT_LINE_ENDING_CRLF=n
#CONFIG_NEWLIB_STDOUT_LINE_ENDING_LF=y
CONFIG_LIBC_STDOUT_LINE_BUF=y
#CONFIG_LIBC_NEWLIB_NANO_FORMAT=n
    # off, by default

#---
# mbedTLS
#
# Optimizes the mbedTLS code size by disabling unused features.
#
# From: 'esp-zigbee-sdk' > ... / utils/example-common/sdkconfig.mbedtls_minimal :
#   -> https://github.com/espressif/esp-zigbee-sdk/blob/main/examples/utils/example_common/sdkconfig.mbedtls_minimal
#
# required
CONFIG_MBEDTLS_AES_C=y
CONFIG_MBEDTLS_CCM_C=y

# unused
CONFIG_MBEDTLS_GCM_C=n
CONFIG_MBEDTLS_CMAC_C=n
CONFIG_MBEDTLS_SHA1_C=n
CONFIG_MBEDTLS_SHA3_C=n
CONFIG_MBEDTLS_SHA512_C=n
CONFIG_MBEDTLS_ECP_DP_SECP384R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP521R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP256K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP256R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP384R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP512R1_ENABLED=n
CONFIG_MBEDTLS_KEY_EXCHANGE_RSA=n
CONFIG_MBEDTLS_KEY_EXCHANGE_RSA_PSK=n
CONFIG_MBEDTLS_KEY_EXCHANGE_ECDHE_RSA=n

# v6.0
CONFIG_MBEDTLS_AES_ONLY_128_BIT_KEY_LENGTH=y
CONFIG_MBEDTLS_CTR_DRBG_C=y
CONFIG_MBEDTLS_HMAC_DRBG_C=n
CONFIG_MBEDTLS_X509_RSASSA_PSS_SUPPORT=n
CONFIG_MBEDTLS_CIPHER_MODE_CBC=n
CONFIG_MBEDTLS_CIPHER_MODE_CFB=n
CONFIG_MBEDTLS_CIPHER_MODE_CTR=n
CONFIG_MBEDTLS_CIPHER_MODE_OFB=n
CONFIG_MBEDTLS_CIPHER_MODE_XTS=n
# "PSA_WANT_ALG_RSA_PSS needs CONFIG_MBEDTLS_RSA_C=y on ESP-IDF master"
#   (comment from 'esp-zigbee-sdk')
CONFIG_MBEDTLS_RSA_C=y
CONFIG_MBEDTLS_MD5_C=n
CONFIG_MBEDTLS_SHA384_C=n
# /mbedTLS

#---
# EXPERIMENTAL
# Trim (aim: faster development builds)
#
# Default is yes; we are not going to use Wifi.
#CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n

# Default is on. The build (ESP-IDF, or 'esp-idf-sys'?) seems to assume LWIP is always enabled.
#CONFIG_LWIP_ENABLE=n
